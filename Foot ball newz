<script>

/* ==========================
   اطلاعات اخبار
========================== */

var data = {

owner:"امیر",

news:[

{
tag:"مهم",
title:"🔥 فوتبال نیوز شروع به کار کرد",
text:"به فوتبال نیوز خوش آمدید؛ مرجع خبری فوتبال."
},

{
tag:"رئال مادرید",
title:"⚪ آخرین اخبار رئال مادرید",
text:"جدیدترین اخبار رئال مادرید را در فوتبال نیوز دنبال کنید."
},

{
tag:"نقل‌وانتقالات",
title:"🔄 بازار نقل‌وانتقالات",
text:"آخرین اخبار نقل‌وانتقالات فوتبال در این بخش منتشر می‌شود."
}

]

};


/* ==========================
   رفتن به بخش
========================== */

function go(id){

var element =
document.getElementById(id);

if(element){

element.scrollIntoView({
behavior:"smooth"
});

}

}


/* ==========================
   نمایش اخبار
========================== */

function showNews(){

var box =
document.getElementById("newsList");

var search =
document.getElementById("search")
.value
.toLowerCase();

box.innerHTML="";

for(
var i=0;
i<data.news.length;
i++
){

var n=data.news[i];

if(
n.title.toLowerCase()
.indexOf(search)===-1 &&

n.text.toLowerCase()
.indexOf(search)===-1
){

continue;

}

box.innerHTML +=

'<div class="card">'+

'<span class="tag">'+
escapeHTML(n.tag)+
'</span>'+

'<h3>'+
escapeHTML(n.title)+
'</h3>'+

'<p>'+
escapeHTML(n.text)+
'</p>'+

'</div>';

}

showAdminNews();

}


/* ==========================
   افزودن خبر
========================== */

function addNews(){

var title =
document.getElementById("newsTitle")
.value;

var tag =
document.getElementById("newsTag")
.value;

var text =
document.getElementById("newsText")
.value;

if(
title==="" ||
text===""
){

alert(
"عنوان و متن خبر را وارد کن."
);

return;

}

data.news.unshift({

tag:tag,

title:title,

text:text

});

document.getElementById(
"newsTitle"
).value="";

document.getElementById(
"newsText"
).value="";

showNews();

alert(
"✅ خبر منتشر شد."
);

}


/* ==========================
   مدیریت خبرها
========================== */

function showAdminNews(){

var box =
document.getElementById("adminNews");

box.innerHTML="";

for(
var i=0;
i<data.news.length;
i++
){

box.innerHTML +=

'<div class="card">'+

'<b>'+
escapeHTML(
data.news[i].title
)+
'</b>'+

'<br><br>'+

'<button '+
'class="btn delete" '+
'onclick="deleteNews('+i+')">'+

'حذف'+

'</button>'+

'</div>';

}

}


function deleteNews(index){

if(
confirm("این خبر حذف شود؟")
){

data.news.splice(
index,
1
);

showNews();

}

}


/* ==========================
   پنل مدیریت
========================== */

function openAdmin(){

var admin =
document.getElementById(
"adminSec"
);

if(
admin.className
.indexOf("show")===-1
){

admin.className=
"section admin show";

}else{

admin.className=
"section admin";

}

go("adminSec");

}


/* ==========================
   تغییر مالک
========================== */

function saveOwner(){

var name =
document.getElementById(
"ownerInput"
).value;

if(name===""){

alert(
"نام مالک را وارد کن."
);

return;

}

data.owner=name;

document.getElementById(
"ownerText"
).innerHTML=
"مالک: "+
escapeHTML(name);

alert(
"✅ مالک تغییر کرد."
);

}


/* ==========================
   API فوتبال
========================== */

/*
کلید API خودت را اینجا قرار بده.

مثال:

var API_KEY="123456";

*/

var API_KEY=
"YOUR_API_KEY";


function loadMatches(){

if(
API_KEY==="YOUR_API_KEY"
){

document.getElementById(
"matches"
).innerHTML=

'<div class="empty">'+

'برای دریافت بازی‌های واقعی، '+
'API Key را وارد کن.'+

'</div>';

return;

}

var date =
new Date()
.toISOString()
.substring(0,10);

fetch(
"https://v3.football.api-sports.io/fixtures?date="
+
date,

{

method:"GET",

headers:{
"x-apisports-key":
API_KEY
}

}

)

.then(function(response){

if(!response.ok){

throw new Error(
"API ERROR"
);

}

return response.json();

})

.then(function(result){

var box =
document.getElementById(
"matches"
);

box.innerHTML="";

if(
!result ||
!result.response ||
result.response.length===0
){

box.innerHTML=
'<div class="empty">'+
'امروز بازی‌ای پیدا نشد.'+
'</div>';

return;

}

var limit =
Math.min(
result.response.length,
20
);

for(
var i=0;
i<limit;
i++
){

var game =
result.response[i];

var home =
game.teams.home.name;

var away =
game.teams.away.name;

var time =
new Date(
game.fixture.date
)
.toLocaleTimeString(
"fa-IR",
{
hour:"2-digit",
minute:"2-digit"
}
);

box.innerHTML +=

'<div class="match">'+

'<b>'+
escapeHTML(home)+
'</b>'+

'<span class="time">'+
time+
'</span>'+

'<b>'+
escapeHTML(away)+
'</b>'+

'</div>';

}

})

.catch(function(){

document.getElementById(
"matches"
).innerHTML=

'<div class="empty">'+

'⚠️ اطلاعات بازی‌ها '+
'فعلاً در دسترس نیست.'+

'</div>';

});

}


/* ==========================
   جلوگیری از HTML خطرناک
========================== */

function escapeHTML(text){

return String(text)

.replace(/&/g,"&amp;")

.replace(/</g,"&lt;")

.replace(/>/g,"&gt;")

.replace(/"/g,"&quot;")

.replace(/'/g,"&#039;");

}


/* ==========================
   شروع
========================== */

document.getElementById(
"ownerText"
).innerHTML=
"مالک: "+
escapeHTML(data.owner);

showNews();

loadMatches();


/*
بازی‌ها هر 10 دقیقه
به‌روزرسانی می‌شوند.
*/

setInterval(
loadMatches,
600000
);

</script>

