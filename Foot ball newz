}

.grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:15px;
}

.card{
background:#0b1d31;
border:1px solid #173b5d;
border-radius:15px;
padding:17px;
}

.card h3{
line-height:1.7;
