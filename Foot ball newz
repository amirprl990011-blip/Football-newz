}

.search{
width:100%;
padding:13px;
border-radius:10px;
border:1px solid #1c4b70;
background:#071525;
color:white;
margin-bottom:15px;
}

.match{
display:grid;
grid-template-columns:1fr auto 1fr;
gap:10px;
align-items:center;
background:#071728;
padding:14px;
margin-bottom:10px;
border-radius:11px;
text-align:center;
}

.score{
font-size:20px;
font-weight:bold;
}

.time{
color:#27c7ff;
font-size:12px;
}

.star{
display:flex;
align-items:center;
gap:18px;
}

.avatar{
width:80px;
height:80px;
border-radius:50%;
background:linear-gradient(135deg,#fff,#54c8ff);
color:#061321;
display:flex;
justify-content:center;
align-items:center;
font-weight:bold;
font-size:20px;
}

.stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:9px;
margin-top:15px;
}

.stat{
background:#071525;
padding:12px;
text-align:center;
border-radius:10px;
}

.stat b{
display:block;
color:#27c7ff;
font-size:22px;
}

.video-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:15px;
}

.video-card{
background:#0b1d31;
border:1px solid #173b5d;
border-radius:15px;
padding:12px;
}

.video-card iframe{
width:100%;
aspect-ratio:16/9;
border:0;
border-radius:10px;
}

.video-card h3{
margin:10px 5px;
}

.sooki-news{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:15px;
}

.sooki-item{
background:#071728;
border:1px solid #17466c;
border-radius:14px;
padding:18px;
}

.sooki-item h3{
line-height:1.7;
}

.sooki-item p{
color:#aebfd2;
line-height:1.9;
}

.sooki-btn{
display:inline-block;
background:#168cff;
color:white;
padding:10px 14px;
border-radius:9px;
margin-top:8px;
text-decoration:none;
}

.sooki-btn:hover{
background:#27c7ff;
color:#061321;
}

.admin{
display:none;
}

.admin.show{
display:block;
}

input,
textarea,
select{
width:100%;
padding:12px;
margin:6px 0;
background:#071525;
color:white;
border:1px solid #1b4c70;
border-radius:9px;
}

textarea{
min-height:100px;
}

.btn{
background:#168cff;
color:white;
border:0;
padding:12px 18px;
border-radius:9px;
cursor:pointer;
}

.btn:hover{
background:#27c7ff;
color:#061321;
}

.delete{
background:#c72f51;
}

.empty{
text-align:center;
color:#91a6bc;
padding:20px;
}

footer{
margin-top:45px;
padding:25px;
text-align:center;
color:#8299b0;
border-top:1px solid #173b5d;
}

table{
width:100%;
border-collapse:collapse;
}

th,
td{
padding:12px;
border-bottom:1px solid #173b5d;
text-align:center;
}

th{
color:#27c7ff;
}

@media(max-width:800px){

