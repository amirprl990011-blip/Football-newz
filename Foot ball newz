padding:20px;
margin:15px 0;
}

.card h3{
color:#58aaff;
}

.card p{
line-height:2;
color:#d6e2ef;
}

input,
textarea{
width:100%;
background:#020914;
color:white;
border:1px solid #20598e;
border-radius:9px;
padding:13px;
margin:7px 0 14px;
font-size:15px;
}

textarea{
height:120px;
resize:vertical;
}

.btn{
background:#087cff;
color:white;
border:0;
border-radius:10px;
padding:12px 20px;
cursor:pointer;
}

.btn:hover{
background:#005ed1;
}

.match{
display:flex;
justify-content:space-around;
align-items:center;
text-align:center;
background:#0a1729;
border:1px solid #16466f;
border-radius:17px;
padding:20px;
margin:12px 0;
}

.team{
width:35%;
}

.vs{
color:#58aaff;
font-weight:bold;
}

.star{
text-align:center;
}

.star-icon{
font-size:90px;
}

.stats{
display:grid;
grid-template-columns:1fr 1fr;
gap:10px;
}

.stat{
background:#061221;
padding:13px;
border-radius:10px;
}

.stat b{
color:#58aaff;
}

.user-news{
border-right:4px solid #087cff;
}

.success{
background:#073b23;
border:1px solid #159957;
padding:12px;
border-radius:10px;
display:none;
margin-bottom:15px;
}

footer{
background:#030913;
color:#8295ad;
text-align:center;
padding:30px;
margin-top:50px;
}

@media(max-width:600px){

header h1{
font-size:28px;
}

.match{
padding:15px 3px;
}

.stats{
grid-template-columns:1fr 1fr;
}

}

